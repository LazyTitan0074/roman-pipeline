# roman-pipeline environment configuration
# Copy this file to .env and fill in your values

# ─── Required: Working directories ───
# BASE_DIR = folder with CANON.md, scripts, logs (this repo's root or a workspace)
BASE_DIR={{BASE_DIR}}

# PROJ_DIR = LibriScribe project folder (projects/<name>/)
PROJ_DIR={{PROJ_DIR}}

# ─── Project metadata ───
PROJECT_NAME={{PROJECT_NAME}}
NUM_CHAPTERS={{NUM_CHAPTERS}}

# ─── Reviewer API keys (at least ONE required for canon checking) ───
# Get from: https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=

# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Get from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Get from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# ─── Writer model (LibriScribe) ───
# Provider: openrouter | google_ai_studio | mistral | groq
WRITER_PROVIDER={{WRITER_PROVIDER}}

# Model: use OpenRouter model slug (e.g., nvidia/nemotron-3-ultra-550b-a55b:free)
# Free 1M context models on OpenRouter:
#   nvidia/nemotron-3-ultra-550b-a55b:free     (1M context, reasoning, tool use)
#   nvidia/nemotron-3-super-120b-a12b:free     (~256K context)
#   nvidia/nemotron-3.5-lightning:free         (~256K context)
WRITER_MODEL={{WRITER_MODEL}}

# Fallback chain (comma-separated, tried in order if primary fails)
WRITER_FALLBACK_CHAIN={{WRITER_FALLBACK_CHAIN}}

# ─── Reviewer model (CanonChecker) ───
REVIEWER_PRIMARY=gemini-2.5-flash-lite
REVIEWER_FALLBACK_CHAIN={{REVIEWER_FALLBACK_CHAIN}}

# ─── Runtime ───
MAX_ATTEMPTS={{MAX_ATTEMPTS}}